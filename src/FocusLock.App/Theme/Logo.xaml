<!--
    The Focus Mood mark: a rounded tile, a ring track, a green arc three quarters round from twelve
    o'clock, and a dot. Drawn on a 96-unit grid.

    Colours are literal rather than Colors.xaml keys: scripts/make-icon.ps1 loads this file on its
    own to render Assets/FocusMood.ico, so it cannot lean on other dictionaries. Run that script
    again after changing a drawing here.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <RectangleGeometry x:Key="LogoTileGeometry" Rect="0,0,96,96" RadiusX="24" RadiusY="24" />
    <EllipseGeometry x:Key="LogoRingGeometry" Center="48,48" RadiusX="26" RadiusY="26" />
    <PathGeometry x:Key="LogoArcGeometry" Figures="M 48,22 A 26,26 0 1 1 22,48" />
    <EllipseGeometry x:Key="LogoDotGeometry" Center="48,48" RadiusX="7" RadiusY="7" />

    <!-- In the app: the light header tile. -->
    <DrawingImage x:Key="LogoLight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#e9e9e7" Geometry="{StaticResource LogoTileGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LogoRingGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#bdbdb8" Thickness="9" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource LogoArcGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#111111" Thickness="9" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#111111" Geometry="{StaticResource LogoDotGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The application icon: dark tile, green arc. -->
    <DrawingImage x:Key="LogoIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#17181a" Geometry="{StaticResource LogoTileGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LogoRingGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2b2f34" Thickness="7" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource LogoArcGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8fd18a" Thickness="7" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#e9e9e7" Geometry="{StaticResource LogoDotGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The icon at 32 px and below, where a 7-unit ring would dissolve into a pixel or two. -->
    <DrawingImage x:Key="LogoIconSmall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#17181a">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,96,96" RadiusX="20" RadiusY="20" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource LogoRingGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3a3f45" Thickness="13" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource LogoArcGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#8fd18a" Thickness="13" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#e9e9e7">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="48,48" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
