<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts (embedded, see Assets/Fonts) -->
    <FontFamily x:Key="FontSans">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="FontIcons">pack://application:,,,/Assets/Fonts/#Material Symbols Rounded</FontFamily>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg" Color="#0e0f10" />
    <SolidColorBrush x:Key="Surface" Color="#17181a" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#1d2023" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#141517" />
    <SolidColorBrush x:Key="SurfaceRow" Color="#1b1d20" />
    <SolidColorBrush x:Key="SurfaceField" Color="#1e2124" />
    <SolidColorBrush x:Key="SurfaceFieldHover" Color="#282c31" />
    <SolidColorBrush x:Key="Hover" Color="#23262a" />
    <SolidColorBrush x:Key="HoverStrong" Color="#2a2d31" />
    <SolidColorBrush x:Key="CanvasBg" Color="#121315" />
    <SolidColorBrush x:Key="Floating" Color="#F217181A" />
    <SolidColorBrush x:Key="Scrim" Color="#E60E0F10" />

    <!-- Borders -->
    <SolidColorBrush x:Key="Border" Color="#2a2d31" />
    <SolidColorBrush x:Key="BorderSoft" Color="#24272b" />
    <SolidColorBrush x:Key="BorderAlt" Color="#222528" />
    <SolidColorBrush x:Key="BorderHover" Color="#34383d" />
    <SolidColorBrush x:Key="BorderHoverStrong" Color="#4a4f55" />
    <SolidColorBrush x:Key="BorderFocus" Color="#5a6067" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text" Color="#e9e9e7" />
    <SolidColorBrush x:Key="TextStrong" Color="#ffffff" />
    <SolidColorBrush x:Key="TextSecondary" Color="#a9adb2" />
    <SolidColorBrush x:Key="TextMuted" Color="#7f8489" />
    <SolidColorBrush x:Key="TextDim" Color="#5f646a" />
    <SolidColorBrush x:Key="TextPlaceholder" Color="#6c7176" />
    <SolidColorBrush x:Key="TextSubtle" Color="#9aa0a6" />
    <SolidColorBrush x:Key="Divider" Color="#3c4045" />
    <SolidColorBrush x:Key="OnLight" Color="#111111" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Light" Color="#e9e9e7" />
    <SolidColorBrush x:Key="Green" Color="#8fd18a" />
    <SolidColorBrush x:Key="GreenBg" Color="#1f2e1f" />
    <SolidColorBrush x:Key="Orange" Color="#ff8a6b" />
    <SolidColorBrush x:Key="Yellow" Color="#f2d06b" />
    <SolidColorBrush x:Key="Danger" Color="#f0b8ae" />
    <SolidColorBrush x:Key="TagBg" Color="#26292d" />
    <SolidColorBrush x:Key="RingTrack" Color="#2b2f34" />
    <SolidColorBrush x:Key="DisabledBg" Color="#22252a" />

</ResourceDictionary>
