<UserControl x:Class="FocusLock.App.Views.PageLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusLock.App.ViewModels"
             xmlns:t="clr-namespace:FocusLock.App.Theme"
             xmlns:ex="clr-namespace:FocusLock.App.Export"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PageLayoutViewModel}"
             Background="{StaticResource Bg}" Foreground="{StaticResource Text}">

    <UserControl.Resources>
        <!-- a small button that shows light when its Tag is True; it never takes focus, so text keeps its selection -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="t:Ui.CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="t:Ui.HoverBackground" Value="{StaticResource Hover}" />
            <Setter Property="t:Ui.HoverForeground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Light}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Light}" />
                    <Setter Property="Foreground" Value="{StaticResource OnLight}" />
                    <Setter Property="t:Ui.HoverBackground" Value="{StaticResource TextStrong}" />
                    <Setter Property="t:Ui.HoverForeground" Value="{StaticResource OnLight}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- a full-width row in the left panel -->
        <Style x:Key="PanelRow" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="t:Ui.CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="t:Ui.HoverBackground" Value="{StaticResource Hover}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- a button in the floating toolbar over the selection -->
        <Style x:Key="MiniTool" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="t:Ui.CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="t:Ui.HoverBackground" Value="{StaticResource HoverStrong}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>

        <Style x:Key="Rule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="Background" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="TopDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="PanelCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,8" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel>
            <!-- ============ top bar ============ -->
            <Border DockPanel.Dock="Top" Height="50" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Close_Click" Style="{StaticResource Flat}" Height="32" Padding="10,0"
                                BorderThickness="1" BorderBrush="{StaticResource Border}" t:Ui.CornerRadius="9"
                                Foreground="{StaticResource TextSecondary}" t:Ui.HoverBackground="{StaticResource Hover}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe5c4;" />
                                <TextBlock Text="Canvas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SessionTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"
                                   MaxWidth="360" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource TopDivider}" />
                        <Button Click="Undo_Click" Style="{StaticResource GhostIconButton}" ToolTip="Undo (Ctrl+Z)" IsEnabled="{Binding CanUndo}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xe166;" />
                        </Button>
                        <Button Click="Redo_Click" Style="{StaticResource GhostIconButton}" ToolTip="Redo (Ctrl+Y)" IsEnabled="{Binding CanRedo}" Margin="2,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xe15a;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                    Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="{x:Static t:Icons.Check}" Foreground="{StaticResource Green}" />
                            <TextBlock Text="Saved" FontSize="11.5" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button Click="Export_Click" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0" MinWidth="124"
                                t:Ui.CornerRadius="9" IsEnabled="{Binding CanExport}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe415;" />
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Export PDF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                                    <Setter Property="Text" Value="Exporting…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ status bar ============ -->
            <Border DockPanel.Dock="Bottom" Height="34" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,420,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding LastExport}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastExport}" Value="">
                                        <Setter Property="Text" Value="{Binding StatusLabel}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="Tidy_Click" Style="{StaticResource Chip}" Margin="0" Height="26" ToolTip="Close the gaps: move everything up as far as it goes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="{x:Static t:Icons.AlignTop}" />
                                <TextBlock Text="Tidy up" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource TopDivider}" Height="16" />
                        <Button Click="ZoomOut_Click" Style="{StaticResource GhostIconButton}" ToolTip="Zoom out (Ctrl+-)" Focusable="False">
                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe15b;" />
                        </Button>
                        <Slider Width="120" Minimum="0.5" Maximum="2" Value="{Binding Zoom, Mode=TwoWay}" VerticalAlignment="Center"
                                Focusable="False" Margin="4,0" ToolTip="Zoom" IsMoveToPointEnabled="True" />
                        <Button Click="ZoomIn_Click" Style="{StaticResource GhostIconButton}" ToolTip="Zoom in (Ctrl+=)" Focusable="False">
                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe145;" />
                        </Button>
                        <Button Click="ZoomReset_Click" Style="{StaticResource Flat}" MinWidth="46" ToolTip="Actual size" Focusable="False">
                            <TextBlock Text="{Binding ZoomLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Click="Fit_Click" Style="{StaticResource Chip}" Margin="4,0,0,0" Height="26" ToolTip="Fit the page width (Ctrl+0)">
                            <TextBlock Text="Fit" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ left: insert, sections, pages ============ -->
            <Border DockPanel.Dock="Left" Width="216" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="INSERT" Margin="2,14,0,8" />
                        <Button Click="AddText_Click" CommandParameter="text" Style="{StaticResource PanelRow}" ToolTip="A text box, under the selected box">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.Title}" Width="22" />
                                <TextBlock Text="Text" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddText_Click" CommandParameter="heading" Style="{StaticResource PanelRow}" ToolTip="A heading">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="H1" FontSize="13" FontWeight="Bold" Width="22" TextAlignment="Center" />
                                <TextBlock Text="Heading" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddText_Click" CommandParameter="table" Style="{StaticResource PanelRow}" ToolTip="A table">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.TableChart}" Width="22" />
                                <TextBlock Text="Table" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddText_Click" CommandParameter="callout" Style="{StaticResource PanelRow}" ToolTip="A coloured note box">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="16">
                                    <Border Width="12" Height="15" Background="#e6f1fb" BorderBrush="#378add" BorderThickness="3,0,0,0" />
                                </Border>
                                <TextBlock Text="Callout" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="AddText_Click" CommandParameter="line" Style="{StaticResource PanelRow}" ToolTip="A dividing line">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe15b;" Width="22" />
                                <TextBlock Text="Line" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource Rule}" />
                        <Grid Margin="2,16,0,8">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SECTIONS" />
                            <TextBlock Text="drag onto a page" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SectionCard}">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="8" Padding="6" Margin="0,0,0,6" Cursor="SizeAll"
                                            PreviewMouseLeftButtonDown="SectionCard_MouseDown" MouseMove="SectionCard_MouseMove"
                                            PreviewMouseLeftButtonUp="SectionCard_MouseUp" ToolTip="Drag onto a page, or click to find it">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="4" ClipToBounds="True" Background="{StaticResource CanvasBg}" Height="38">
                                                <Image Source="{Binding Picture}" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PageLabel}" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Click="PickRegion_Click" Style="{StaticResource PanelRow}" Foreground="{StaticResource TextSecondary}" ToolTip="Back to the canvas to pick another region">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.Crop}" Width="22" />
                                <TextBlock Text="Pick a region" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource Rule}" />
                        <Grid Margin="2,16,0,8">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="PAGES" />
                            <TextBlock Text="drag to reorder" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl x:Name="PageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageThumb}">
                                    <Grid Margin="0,0,0,8" Background="Transparent" Cursor="Hand"
                                          PreviewMouseLeftButtonDown="PageThumb_MouseDown" MouseMove="PageThumb_MouseMove"
                                          PreviewMouseLeftButtonUp="PageThumb_MouseUp">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="2,2,0,0" />
                                        <Border Grid.Column="1" HorizontalAlignment="Left" BorderThickness="2" CornerRadius="3" Padding="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#378add" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Picture}" Width="104" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Click="AddPage_Click" Style="{StaticResource PanelRow}" Foreground="{StaticResource TextSecondary}" Margin="26,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.Add}" />
                                <TextBlock Text="Add page" FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ right: what is selected, formatting, or page and document ============ -->
            <Border DockPanel.Dock="Right" Width="272" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,12,16">
                    <Grid>
                        <!-- nothing selected: the page in view and the whole document -->
                        <StackPanel Visibility="{Binding ShowsPageSettings, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Heading}" Text="{Binding CurrentPageTitle}" Margin="2,14,0,8" />
                            <WrapPanel>
                                <Button Click="Portrait_Click" Style="{StaticResource Chip}" Tag="{Binding CurrentLandscape, Converter={StaticResource Not}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe3c5;" />
                                        <TextBlock Text="Portrait" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Landscape_Click" Style="{StaticResource Chip}" Tag="{Binding CurrentLandscape}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe3c3;" />
                                        <TextBlock Text="Landscape" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Button Click="DeletePage_Click" Style="{StaticResource Chip}" HorizontalAlignment="Left" IsEnabled="{Binding CanDeletePage}"
                                    t:Ui.HoverForeground="{StaticResource Danger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="{x:Static t:Icons.Delete}" />
                                    <TextBlock Text="Delete page" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Style="{StaticResource Rule}" />
                            <TextBlock Style="{StaticResource Heading}" Text="DOCUMENT" />
                            <TextBlock Text="Paper" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="2,0,0,6" />
                            <WrapPanel>
                                <Button Click="White_Click" Style="{StaticResource Chip}" Content="White" Tag="{Binding Light}" />
                                <Button Click="Dark_Click" Style="{StaticResource Chip}" Content="Dark" Tag="{Binding Light, Converter={StaticResource Not}}" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource PanelCheck}" Content="Section titles" IsChecked="{Binding Titles, Mode=OneWay}" Click="Titles_Click" />
                            <CheckBox Style="{StaticResource PanelCheck}" Content="Header on every page" IsChecked="{Binding Header, Mode=OneWay}" Click="Header_Click" />
                            <TextBox x:Name="HeaderBox" Style="{StaticResource InputBox}" Text="{Binding HeaderText, Mode=OneWay}" Height="30"
                                     FontSize="12" Margin="0,0,0,10" Padding="8,0" VerticalContentAlignment="Center"
                                     t:Ui.Placeholder="{Binding HeaderPlaceholder}" IsEnabled="{Binding Header}"
                                     LostFocus="HeaderText_LostFocus" KeyDown="HeaderText_KeyDown" />
                            <CheckBox Style="{StaticResource PanelCheck}" Content="Page numbers" IsChecked="{Binding PageNumbers, Mode=OneWay}" Click="PageNumbers_Click" />

                            <Border Style="{StaticResource Rule}" />
                            <TextBlock Style="{StaticResource Heading}" Text="SHORTCUTS" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" LineHeight="19" TextWrapping="Wrap"
                                       Text="Double-click text to type · Tab next box · Arrows nudge (Shift ×10) · Ctrl+D duplicate · Delete remove · Ctrl+Z undo · Ctrl+0 fit · PageUp/PageDown · Alt while dragging: no snapping" />
                        </StackPanel>

                        <!-- a section or text box selected -->
                        <StackPanel Visibility="{Binding ShowsSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Heading}" Text="{Binding SelectionTitle}" Margin="2,14,0,4" />
                            <TextBlock Text="{Binding SelectedName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,0,0,4" />

                            <TextBlock Style="{StaticResource Heading}" Text="WIDTH" />
                            <WrapPanel>
                                <Button Click="Width_Click" CommandParameter="1" Style="{StaticResource Chip}" Content="Full" />
                                <Button Click="Width_Click" CommandParameter="0.5" Style="{StaticResource Chip}" Content="Half" />
                                <Button Click="Width_Click" CommandParameter="0.3333" Style="{StaticResource Chip}" Content="Third" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Heading}" Text="POSITION ON THE PAGE" />
                            <WrapPanel>
                                <Button Click="AlignBox_Click" CommandParameter="left" Style="{StaticResource Chip}" ToolTip="Left margin">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe236;" />
                                </Button>
                                <Button Click="AlignBox_Click" CommandParameter="center" Style="{StaticResource Chip}" ToolTip="Middle">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe234;" />
                                </Button>
                                <Button Click="AlignBox_Click" CommandParameter="right" Style="{StaticResource Chip}" ToolTip="Right margin">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe237;" />
                                </Button>
                            </WrapPanel>

                            <Border Style="{StaticResource Rule}" />
                            <StackPanel Margin="0,14,0,0">
                                <Button Click="Edit_Click" Style="{StaticResource PanelRow}" Visibility="{Binding IsTextSelected, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.Edit}" Width="22" />
                                        <TextBlock Text="Edit text" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Enter" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Duplicate_Click" Style="{StaticResource PanelRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.ContentCopy}" Width="22" />
                                        <TextBlock Text="Duplicate" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Ctrl+D" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Delete_Click" Style="{StaticResource PanelRow}" t:Ui.HoverForeground="{StaticResource Danger}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="{x:Static t:Icons.Delete}" Width="22" />
                                        <TextBlock Text="Remove" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- typing in a text box: formatting -->
                        <StackPanel DataContext="{Binding Format}"
                                    Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="2,14,0,4">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="TEXT" VerticalAlignment="Center" />
                                <Button Click="Done_Click" Style="{StaticResource PrimaryButton}" Height="28" Padding="14,0" t:Ui.CornerRadius="8"
                                        HorizontalAlignment="Right" Focusable="False" ToolTip="Finish typing (Esc)">
                                    <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                            </Grid>

                            <TextBlock Style="{StaticResource Heading}" Text="STYLE" Margin="2,10,0,8" />
                            <WrapPanel>
                                <Button Click="Style_Click" CommandParameter="title" Style="{StaticResource Chip}"
                                        Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=title}">
                                    <TextBlock Text="Title" FontWeight="Bold" />
                                </Button>
                                <Button Click="Style_Click" CommandParameter="h1" Style="{StaticResource Chip}"
                                        Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=h1}">
                                    <TextBlock Text="H1" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="Style_Click" CommandParameter="h2" Style="{StaticResource Chip}"
                                        Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=h2}">
                                    <TextBlock Text="H2" FontWeight="SemiBold" />
                                </Button>
                                <Button Click="Style_Click" CommandParameter="normal" Style="{StaticResource Chip}" Content="Normal"
                                        Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=normal}" />
                            </WrapPanel>

                            <Grid Margin="0,4,0,0">
                                <WrapPanel>
                                    <Button Click="Bold_Click" Style="{StaticResource Chip}" Tag="{Binding IsBold}" ToolTip="Bold (Ctrl+B)">
                                        <TextBlock Text="B" FontWeight="Bold" FontSize="13" />
                                    </Button>
                                    <Button Click="Italic_Click" Style="{StaticResource Chip}" Tag="{Binding IsItalic}" ToolTip="Italic (Ctrl+I)">
                                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="13" />
                                    </Button>
                                    <Button Click="Underline_Click" Style="{StaticResource Chip}" Tag="{Binding IsUnderline}" ToolTip="Underline (Ctrl+U)">
                                        <TextBlock Text="U" TextDecorations="Underline" FontSize="13" />
                                    </Button>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Click="Smaller_Click" Style="{StaticResource Chip}" Margin="0,0,0,6" ToolTip="Smaller">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe15b;" />
                                    </Button>
                                    <TextBlock Text="{Binding SizeLabel}" FontSize="12" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6" />
                                    <Button Click="Bigger_Click" Style="{StaticResource Chip}" Margin="0,0,0,6" ToolTip="Bigger">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe145;" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Heading}" Text="COLOUR" />
                            <WrapPanel>
                                <Button Click="ColorNone_Click" Style="{StaticResource Chip}" Content="Auto" Height="24" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding TextColors}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Color_Click" Style="{StaticResource Flat}" Width="20" Height="20" Margin="0,2,6,6" t:Ui.CornerRadius="10" Focusable="False"
                                                    Background="{Binding Converter={StaticResource HexBrush}}" BorderThickness="1" BorderBrush="{StaticResource BorderHoverStrong}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Click="HighlightNone_Click" Style="{StaticResource Chip}" Content="No highlight" Height="24" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding Highlights}" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="Highlight_Click" Style="{StaticResource Flat}" Width="20" Height="20" Margin="0,2,6,6" t:Ui.CornerRadius="5" Focusable="False"
                                                    Background="{Binding Converter={StaticResource HexBrush}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Heading}" Text="PARAGRAPH" />
                            <WrapPanel>
                                <Button Click="Align_Click" CommandParameter="left" Style="{StaticResource Chip}" ToolTip="Align left"
                                        Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Left}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe236;" />
                                </Button>
                                <Button Click="Align_Click" CommandParameter="center" Style="{StaticResource Chip}" ToolTip="Centre"
                                        Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Center}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe234;" />
                                </Button>
                                <Button Click="Align_Click" CommandParameter="right" Style="{StaticResource Chip}" ToolTip="Align right"
                                        Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Right}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe237;" />
                                </Button>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Click="List_Click" CommandParameter="bullet" Style="{StaticResource Chip}" ToolTip="Bullet list"
                                        Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=bullet}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe241;" />
                                </Button>
                                <Button Click="List_Click" CommandParameter="number" Style="{StaticResource Chip}" ToolTip="Numbered list"
                                        Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=number}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe242;" />
                                </Button>
                                <Button Click="List_Click" CommandParameter="check" Style="{StaticResource Chip}" ToolTip="Checklist"
                                        Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=check}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe834;" />
                                </Button>
                            </WrapPanel>

                            <TextBlock Style="{StaticResource Heading}" Text="INSERT IN THE TEXT" />
                            <WrapPanel>
                                <Button Click="InsertTable_Click" Style="{StaticResource Chip}" ToolTip="A table at the caret">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="{x:Static t:Icons.TableChart}" />
                                        <TextBlock Text="Table" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Divider_Click" Style="{StaticResource Chip}" ToolTip="A dividing line">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe15b;" />
                                        <TextBlock Text="Line" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="PageBreak_Click" Style="{StaticResource Chip}" ToolTip="Continue on the next page (Ctrl+Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xeaca;" />
                                        <TextBlock Text="Page break" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Click="Callout_Click" CommandParameter="note" Style="{StaticResource Chip}" ToolTip="Note box">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="13" Background="#378add" Margin="0,0,6,0" />
                                        <TextBlock Text="Note" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Callout_Click" CommandParameter="important" Style="{StaticResource Chip}" ToolTip="Important box">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="13" Background="#ba7517" Margin="0,0,6,0" />
                                        <TextBlock Text="Important" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Callout_Click" CommandParameter="tip" Style="{StaticResource Chip}" ToolTip="Tip box">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" Height="13" Background="#639922" Margin="0,0,6,0" />
                                        <TextBlock Text="Tip" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <StackPanel Visibility="{Binding InTable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Heading}" Text="TABLE" />
                                <WrapPanel>
                                    <Button Click="RowAbove_Click" Style="{StaticResource Chip}" Content="Row above" />
                                    <Button Click="RowBelow_Click" Style="{StaticResource Chip}" Content="Row below" />
                                    <Button Click="ColumnLeft_Click" Style="{StaticResource Chip}" Content="Column left" />
                                    <Button Click="ColumnRight_Click" Style="{StaticResource Chip}" Content="Column right" />
                                    <Button Click="DeleteRow_Click" Style="{StaticResource Chip}" Content="Delete row" t:Ui.HoverForeground="{StaticResource Danger}" />
                                    <Button Click="DeleteColumn_Click" Style="{StaticResource Chip}" Content="Delete column" t:Ui.HoverForeground="{StaticResource Danger}" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ============ pages ============ -->
            <Grid>
                <ex:PageBoard x:Name="Board" />

                <Canvas x:Name="Overlay" ClipToBounds="True">
                    <!-- the editor sits over the text box being typed in -->
                    <Border x:Name="EditorFrame" Visibility="Collapsed" BorderBrush="#378add" BorderThickness="1.5" Margin="-3">
                        <RichTextBox x:Name="Editor" Margin="1.5" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                     FocusVisualStyle="{x:Null}" Background="Transparent" />
                    </Border>

                    <!-- the floating toolbar over the selected box -->
                    <Border x:Name="MiniBar" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderHover}"
                            BorderThickness="1" CornerRadius="10" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="Width_Click" CommandParameter="1" Style="{StaticResource MiniTool}" Content="Full" ToolTip="Full width" />
                            <Button Click="Width_Click" CommandParameter="0.5" Style="{StaticResource MiniTool}" Content="½" ToolTip="Half width" />
                            <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="3,0" />
                            <Button Click="AlignBox_Click" CommandParameter="left" Style="{StaticResource MiniTool}" ToolTip="Left margin">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe236;" />
                            </Button>
                            <Button Click="AlignBox_Click" CommandParameter="center" Style="{StaticResource MiniTool}" ToolTip="Middle">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe234;" />
                            </Button>
                            <Button Click="AlignBox_Click" CommandParameter="right" Style="{StaticResource MiniTool}" ToolTip="Right margin">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe237;" />
                            </Button>
                            <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="3,0" />
                            <Button Click="Edit_Click" Style="{StaticResource MiniTool}" ToolTip="Edit text (Enter)"
                                    Visibility="{Binding IsTextSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{x:Static t:Icons.Edit}" />
                            </Button>
                            <Button Click="Duplicate_Click" Style="{StaticResource MiniTool}" ToolTip="Duplicate (Ctrl+D)">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{x:Static t:Icons.ContentCopy}" />
                            </Button>
                            <Button Click="Delete_Click" Style="{StaticResource MiniTool}" ToolTip="Remove (Delete)" t:Ui.HoverForeground="{StaticResource Danger}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="{x:Static t:Icons.Delete}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>
        </DockPanel>

        <!-- things carried by the pointer across panels -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False">
            <Border x:Name="DragGhost" Visibility="Collapsed" Width="130" Background="{StaticResource Surface}" BorderBrush="#378add"
                    BorderThickness="1.5" CornerRadius="8" Padding="5" Opacity="0.92">
                <StackPanel>
                    <Image x:Name="DragGhostImage" Height="52" Stretch="Uniform" />
                    <TextBlock x:Name="DragGhostName" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border x:Name="PageDropLine" Visibility="Collapsed" Height="3" Width="120" Background="#378add" CornerRadius="1.5" />
        </Canvas>
    </Grid>
</UserControl>
