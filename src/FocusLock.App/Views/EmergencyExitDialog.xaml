<Window x:Class="FocusLock.App.Views.EmergencyExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:FocusLock.App.Theme"
        Title="Emergency exit"
        Width="760" Height="620"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FontSans}"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}">

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="28">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Orange}" Text="&#xf083;" />
                    <TextBlock Text="Emergency exit" FontSize="19" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"
                           Text="This ends the session early. Type the text below exactly, by hand — it cannot be pasted. The length is the point: it makes leaving a deliberate act rather than an impulse." />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid>
                    <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource Flat}"
                                Height="40" t:Ui.CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource Border}" Foreground="{StaticResource TextSecondary}"
                                t:Ui.HoverBackground="{StaticResource Hover}" t:Ui.HoverForeground="{StaticResource Text}">
                            <TextBlock Text="Stay in the session" FontSize="13" FontWeight="SemiBold" Margin="18,0" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="UnlockButton" Click="Unlock_Click" Style="{StaticResource PrimaryButton}"
                                Height="40" Margin="10,0,0,0" IsEnabled="False">
                            <TextBlock Text="Unlock" FontSize="13" FontWeight="SemiBold" Margin="24,0" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderAlt}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="CodeText" Style="{StaticResource Mono}" FontSize="13.5" LineHeight="24"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <TextBox Grid.Row="1" x:Name="Input" Margin="0,12,0,0" Height="96"
                         Style="{StaticResource InputBox}" AcceptsReturn="False" AllowDrop="False"
                         FontFamily="{StaticResource FontMono}" FontSize="13.5" FontWeight="Normal"
                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="14,12"
                         t:Ui.Placeholder="Type the text above" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
