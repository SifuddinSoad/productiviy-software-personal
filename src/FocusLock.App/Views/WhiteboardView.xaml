<UserControl x:Class="FocusLock.App.Views.WhiteboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusLock.App.ViewModels"
             xmlns:t="clr-namespace:FocusLock.App.Theme"
             d:DataContext="{d:DesignInstance vm:WhiteboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{StaticResource Bg}">

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Click="Back_Click" Style="{StaticResource OutlineIconButton}"
                            Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xe5c4;" />
                    </Button>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Light}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource OnLight}" Text="&#xe53b;" />
                    </Border>
                    <TextBlock Text="{Binding PlanName}" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Timer pill -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Height="32" CornerRadius="9"
                        Background="#1f2226" BorderBrush="#2f3338" BorderThickness="1" Padding="10,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe899;"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Style="{StaticResource Mono}" Text="{Binding TimerLabel}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Text="session" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                   Margin="0,0,6,0" Visibility="{Binding TimerRunning, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="EndButton" Click="End_Click" Style="{StaticResource PrimaryButton}"
                                Height="24" t:Ui.CornerRadius="7" Margin="0,0,2,0"
                                Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="End session" FontSize="11.5" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>

                <Button x:Name="ContinueButton" Click="Continue_Click" Style="{StaticResource PrimaryButton}"
                        Height="32" t:Ui.CornerRadius="9" HorizontalAlignment="Right"
                        Visibility="{Binding CanContinue, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="12,0">
                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe037;" />
                        <TextBlock Text="Continue remaining plans" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Canvas placeholder (full board arrives in Phase 1b) -->
        <Grid Background="{StaticResource CanvasBg}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource HoverStrong}" Text="&#xe3c2;"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Canvas" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock Text="{Binding PlanName}" FontSize="12" Foreground="{StaticResource TextDim}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
