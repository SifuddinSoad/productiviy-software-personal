<UserControl x:Class="FocusLock.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusLock.App.ViewModels"
             xmlns:t="clr-namespace:FocusLock.App.Theme"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Background="{StaticResource Bg}">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="52" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Light}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource OnLight}"
                                   Text="&#xe53b;" />
                    </Border>
                    <TextBlock Text="Saidrix Studio" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Mono}" Text="{Binding TodayLabel}" FontSize="11"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,46,24,60">
                <StackPanel MaxWidth="880" HorizontalAlignment="Center">

                    <!-- Hero -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Ready when you are" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="Set a name, a length, and the plans you want to work through. The canvas locks until the timer runs out."
                                   FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="420" Margin="0,16,0,0" />
                        <Button x:Name="NewSessionButton" Click="NewSession_Click"
                                Style="{StaticResource PrimaryButton}" Height="46" Margin="0,22,0,0"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="22,0">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xe145;" />
                                <TextBlock Text="Start a New Focus Session" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Previous sessions -->
                    <StackPanel Margin="0,28,0,0">
                        <Grid Margin="2,0,2,10">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="PREVIOUS SESSIONS"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Mono}" Text="{Binding SessionCount}" FontSize="11"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                <Button Click="ClearAll_Click" Style="{StaticResource Flat}" Height="22" Margin="12,0,0,0"
                                        t:Ui.CornerRadius="6" Foreground="{StaticResource TextMuted}"
                                        t:Ui.HoverBackground="{StaticResource Hover}" t:Ui.HoverForeground="{StaticResource Danger}">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                            <Binding Path="HasSessions" />
                                            <Binding Path="ConfirmingClearAll" Converter="{StaticResource Not}" />
                                        </MultiBinding>
                                    </Button.Visibility>
                                    <StackPanel Orientation="Horizontal" Margin="7,0">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xe92e;" />
                                        <TextBlock Text="Clear all" FontSize="11" VerticalAlignment="Center" Margin="5,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- confirm before wiping the lot: the canvases go with them -->
                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderHover}"
                                BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,10"
                                Visibility="{Binding ConfirmingClearAll, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="17" Foreground="{StaticResource Orange}" Text="&#xf083;" />
                                    <TextBlock Text="{Binding ClearAllPrompt}" FontSize="12.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                                    <TextBlock Text="The canvases go with them." FontSize="11.5"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="CancelClearAll_Click" Style="{StaticResource Flat}" Height="30"
                                            t:Ui.CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Border}"
                                            Foreground="{StaticResource TextSecondary}"
                                            t:Ui.HoverBackground="{StaticResource Hover}" t:Ui.HoverForeground="{StaticResource Text}">
                                        <TextBlock Text="Keep them" FontSize="12" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center" />
                                    </Button>
                                    <Button Click="ConfirmClearAll_Click" Style="{StaticResource Flat}" Height="30" Margin="8,0,0,0"
                                            t:Ui.CornerRadius="8" Background="{StaticResource Danger}" Foreground="{StaticResource OnLight}"
                                            t:Ui.HoverBackground="#f7cdc5">
                                        <TextBlock Text="Delete all" FontSize="12" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="No sessions yet. Start your first one above."
                                   FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="2,6,0,0"
                                   Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisInv}}" />

                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SessionRow}">
                                    <Button Click="Session_Click" Style="{StaticResource Flat}" Margin="0,0,0,10"
                                            HorizontalContentAlignment="Stretch">
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1" CornerRadius="13" Padding="18,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                        <Border CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center"
                                                                Background="{Binding RingColor, Converter={StaticResource HexBrush}}"
                                                                Opacity="0.22">
                                                            <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextStrong}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Range}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="|" Foreground="{StaticResource Divider}" Margin="14,0" />
                                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Hours}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Text="|" Foreground="{StaticResource Divider}" Margin="14,0" />
                                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding PlanLine}" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisInv}}">
                                                    <TextBlock Text="{Binding PctLabel}" FontSize="12" FontWeight="SemiBold" Width="38"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{Binding RingColor, Converter={StaticResource HexBrush}}" />
                                                    <Grid Width="34" Height="34" Margin="12,0,0,0">
                                                        <Ellipse Width="28" Height="28" Stroke="{StaticResource RingTrack}" StrokeThickness="3" />
                                                        <Path Data="{Binding ArcData}" Stroke="{Binding RingColor, Converter={StaticResource HexBrush}}"
                                                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              RenderTransformOrigin="0.5,0.5" Width="34" Height="34" Stretch="None"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse Width="28" Height="28" Stroke="{Binding RingColor, Converter={StaticResource HexBrush}}"
                                                                 StrokeThickness="3"
                                                                 Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <Button Click="AskDelete_Click" Style="{StaticResource GhostIconButton}" Width="30" Height="30"
                                                            Margin="10,0,0,0" ToolTip="Delete this session"
                                                            Foreground="{StaticResource TextDim}"
                                                            t:Ui.HoverForeground="{StaticResource Danger}">
                                                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe92e;" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- the same row, asking first -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Delete this session?" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                                                    <Button Click="CancelDelete_Click" Style="{StaticResource Flat}" Height="30"
                                                            t:Ui.CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Border}"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            t:Ui.HoverBackground="{StaticResource Hover}" t:Ui.HoverForeground="{StaticResource Text}">
                                                        <TextBlock Text="Keep" FontSize="12" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Click="ConfirmDelete_Click" Style="{StaticResource Flat}" Height="30" Margin="8,0,0,0"
                                                            t:Ui.CornerRadius="8" Background="{StaticResource Danger}"
                                                            Foreground="{StaticResource OnLight}" t:Ui.HoverBackground="#f7cdc5">
                                                        <TextBlock Text="Delete" FontSize="12" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
