<UserControl x:Class="FocusLock.App.Views.DocumentEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FocusLock.App.ViewModels"
             xmlns:t="clr-namespace:FocusLock.App.Theme"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DocumentEditorViewModel}"
             Background="{StaticResource Bg}" Foreground="{StaticResource Text}">

    <UserControl.Resources>
        <!-- a toolbar button that shows light when its Tag is True -->
        <Style x:Key="DocTool" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="t:Ui.CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="t:Ui.HoverBackground" Value="{StaticResource Hover}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Light}" />
                    <Setter Property="Foreground" Value="{StaticResource OnLight}" />
                    <Setter Property="t:Ui.HoverBackground" Value="{StaticResource TextStrong}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelTool" TargetType="Button" BasedOn="{StaticResource DocTool}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="9,0" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="{StaticResource Border}" />
        </Style>

        <Style x:Key="PanelHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ toolbar ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="Preview_Click" Style="{StaticResource DocTool}"
                        Tag="{Binding IsPreview}" Padding="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe8f4;" />
                        <TextBlock Text="Preview" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding IsPreview, Converter={StaticResource Not}}">
                    <Button Click="Style_Click" CommandParameter="title" Style="{StaticResource DocTool}" ToolTip="Title"
                            Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=title}">
                        <TextBlock Text="Title" FontSize="12" FontWeight="Bold" />
                    </Button>
                    <Button Click="Style_Click" CommandParameter="h1" Style="{StaticResource DocTool}" ToolTip="Heading 1"
                            Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=h1}">
                        <TextBlock Text="H1" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button Click="Style_Click" CommandParameter="h2" Style="{StaticResource DocTool}" ToolTip="Heading 2"
                            Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=h2}">
                        <TextBlock Text="H2" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button Click="Style_Click" CommandParameter="normal" Style="{StaticResource DocTool}" ToolTip="Normal text"
                            Tag="{Binding CurrentStyle, Converter={StaticResource Equals}, ConverterParameter=normal}">
                        <TextBlock Text="Normal" FontSize="12" />
                    </Button>

                    <Border Style="{StaticResource Divider}" />
                    <Button Click="Smaller_Click" Style="{StaticResource DocTool}" ToolTip="Smaller">
                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe15b;" />
                    </Button>
                    <TextBlock Text="{Binding SizeLabel}" FontSize="12" MinWidth="26" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Text}" />
                    <Button Click="Bigger_Click" Style="{StaticResource DocTool}" ToolTip="Bigger">
                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe145;" />
                    </Button>

                    <Border Style="{StaticResource Divider}" />
                    <Button Click="Bold_Click" Style="{StaticResource DocTool}" Tag="{Binding IsBold}" ToolTip="Bold (Ctrl+B)">
                        <TextBlock Text="B" FontSize="13" FontWeight="Bold" />
                    </Button>
                    <Button Click="Italic_Click" Style="{StaticResource DocTool}" Tag="{Binding IsItalic}" ToolTip="Italic (Ctrl+I)">
                        <TextBlock Text="I" FontSize="13" FontStyle="Italic" FontFamily="Georgia" />
                    </Button>
                    <Button Click="Underline_Click" Style="{StaticResource DocTool}" Tag="{Binding IsUnderline}" ToolTip="Underline (Ctrl+U)">
                        <TextBlock Text="U" FontSize="13" TextDecorations="Underline" />
                    </Button>

                    <Border Style="{StaticResource Divider}" />
                    <Button Click="Align_Click" CommandParameter="left" Style="{StaticResource DocTool}" ToolTip="Align left"
                            Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Left}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe236;" />
                    </Button>
                    <Button Click="Align_Click" CommandParameter="center" Style="{StaticResource DocTool}" ToolTip="Centre"
                            Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Center}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe234;" />
                    </Button>
                    <Button Click="Align_Click" CommandParameter="right" Style="{StaticResource DocTool}" ToolTip="Align right"
                            Tag="{Binding CurrentAlignment, Converter={StaticResource Equals}, ConverterParameter=Right}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe237;" />
                    </Button>

                    <Border Style="{StaticResource Divider}" />
                    <Button Click="List_Click" CommandParameter="bullet" Style="{StaticResource DocTool}" ToolTip="Bullet list"
                            Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=bullet}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe241;" />
                    </Button>
                    <Button Click="List_Click" CommandParameter="number" Style="{StaticResource DocTool}" ToolTip="Numbered list"
                            Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=number}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe242;" />
                    </Button>
                    <Button Click="List_Click" CommandParameter="check" Style="{StaticResource DocTool}" ToolTip="Checklist"
                            Tag="{Binding CurrentList, Converter={StaticResource Equals}, ConverterParameter=check}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xe834;" />
                    </Button>

                    <Border Style="{StaticResource Divider}" />
                    <Button Click="PageBreak_Click" Style="{StaticResource DocTool}" ToolTip="Page break (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xeaca;" />
                            <TextBlock Text="Page break" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ side panel ============ -->
        <Border DockPanel.Dock="Right" Width="272" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,0,10,16">
                <StackPanel IsEnabled="{Binding IsPreview, Converter={StaticResource Not}}">

                    <!-- section settings, only while a picture is selected -->
                    <StackPanel Visibility="{Binding HasSection, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelHeading}" Text="SECTION" />
                        <WrapPanel>
                            <Button Click="SectionSize_Click" CommandParameter="small" Style="{StaticResource PanelTool}" Content="Small" FontSize="11.5"
                                    Tag="{Binding SectionSize, Converter={StaticResource Equals}, ConverterParameter=small}" />
                            <Button Click="SectionSize_Click" CommandParameter="medium" Style="{StaticResource PanelTool}" Content="Medium" FontSize="11.5"
                                    Tag="{Binding SectionSize, Converter={StaticResource Equals}, ConverterParameter=medium}" />
                            <Button Click="SectionSize_Click" CommandParameter="full" Style="{StaticResource PanelTool}" Content="Full width" FontSize="11.5"
                                    Tag="{Binding SectionSize, Converter={StaticResource Equals}, ConverterParameter=full}" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Click="SectionAlign_Click" CommandParameter="left" Style="{StaticResource PanelTool}" ToolTip="Left"
                                    Tag="{Binding SectionAlign, Converter={StaticResource Equals}, ConverterParameter=left}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe236;" />
                            </Button>
                            <Button Click="SectionAlign_Click" CommandParameter="center" Style="{StaticResource PanelTool}" ToolTip="Centre"
                                    Tag="{Binding SectionAlign, Converter={StaticResource Equals}, ConverterParameter=center}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe234;" />
                            </Button>
                            <Button Click="SectionAlign_Click" CommandParameter="right" Style="{StaticResource PanelTool}" ToolTip="Right"
                                    Tag="{Binding SectionAlign, Converter={StaticResource Equals}, ConverterParameter=right}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xe237;" />
                            </Button>
                            <Button Click="SectionCaption_Click" Style="{StaticResource PanelTool}" Content="Caption" FontSize="11.5" Tag="{Binding SectionCaption}" />
                        </WrapPanel>
                        <Button Click="SectionRemove_Click" Style="{StaticResource PanelTool}" Content="Remove from document" FontSize="11.5"
                                HorizontalAlignment="Left" t:Ui.HoverForeground="{StaticResource Danger}" />
                    </StackPanel>

                    <!-- table, only while the caret is in one -->
                    <StackPanel Visibility="{Binding InTable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PanelHeading}" Text="TABLE" />
                        <WrapPanel>
                            <Button Click="RowAbove_Click" Style="{StaticResource PanelTool}" Content="Row above" FontSize="11.5" />
                            <Button Click="RowBelow_Click" Style="{StaticResource PanelTool}" Content="Row below" FontSize="11.5" />
                            <Button Click="ColumnLeft_Click" Style="{StaticResource PanelTool}" Content="Column left" FontSize="11.5" />
                            <Button Click="ColumnRight_Click" Style="{StaticResource PanelTool}" Content="Column right" FontSize="11.5" />
                            <Button Click="DeleteRow_Click" Style="{StaticResource PanelTool}" Content="Delete row" FontSize="11.5" t:Ui.HoverForeground="{StaticResource Danger}" />
                            <Button Click="DeleteColumn_Click" Style="{StaticResource PanelTool}" Content="Delete column" FontSize="11.5" t:Ui.HoverForeground="{StaticResource Danger}" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="TEXT COLOUR" />
                    <WrapPanel>
                        <Button Click="ColorNone_Click" Style="{StaticResource PanelTool}" Content="Auto" FontSize="11" Height="24" />
                        <ItemsControl ItemsSource="{Binding TextColors}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Color_Click" Style="{StaticResource Flat}" Width="22" Height="22" Margin="0,1,5,5" t:Ui.CornerRadius="11"
                                            Background="{Binding Converter={StaticResource HexBrush}}" Focusable="False"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderHoverStrong}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="HIGHLIGHT" />
                    <WrapPanel>
                        <Button Click="HighlightNone_Click" Style="{StaticResource PanelTool}" Content="None" FontSize="11" Height="24" />
                        <ItemsControl ItemsSource="{Binding Highlights}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="Highlight_Click" Style="{StaticResource Flat}" Width="22" Height="22" Margin="0,1,5,5" t:Ui.CornerRadius="5"
                                            Background="{Binding Converter={StaticResource HexBrush}}" Focusable="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="INSERT" />
                    <WrapPanel>
                        <Button Click="Callout_Click" CommandParameter="note" Style="{StaticResource PanelTool}" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="12" Background="#378add" Margin="0,0,6,0" />
                                <TextBlock Text="Note" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="Callout_Click" CommandParameter="important" Style="{StaticResource PanelTool}" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="12" Background="#ba7517" Margin="0,0,6,0" />
                                <TextBlock Text="Important" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="Callout_Click" CommandParameter="tip" Style="{StaticResource PanelTool}" FontSize="11.5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="12" Background="#639922" Margin="0,0,6,0" />
                                <TextBlock Text="Tip" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="Divider_Click" Style="{StaticResource PanelTool}" Content="Divider" FontSize="11.5" />
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,2,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Rows" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="RowsLess_Click" Style="{StaticResource DocTool}" Height="24"><TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe15b;" /></Button>
                                    <TextBlock Text="{Binding TableRows}" FontSize="12" MinWidth="22" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Click="RowsMore_Click" Style="{StaticResource DocTool}" Height="24"><TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe145;" /></Button>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Columns" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="ColumnsLess_Click" Style="{StaticResource DocTool}" Height="24"><TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe15b;" /></Button>
                                    <TextBlock Text="{Binding TableColumns}" FontSize="12" MinWidth="22" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Click="ColumnsMore_Click" Style="{StaticResource DocTool}" Height="24"><TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe145;" /></Button>
                                </StackPanel>
                            </Grid>
                            <Button Click="Table_Click" Style="{StaticResource PanelTool}" Content="Insert table" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="SECTIONS" />
                    <ItemsControl ItemsSource="{Binding Extracts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExtractCard}">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                    <Button Click="InsertSection_Click" Style="{StaticResource PanelTool}" Content="Insert" FontSize="11" Height="24"
                                            HorizontalAlignment="Right" Margin="0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Pick a region on the canvas to add more." FontSize="10.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource PanelHeading}" Text="PAGE SETUP" />
                    <WrapPanel>
                        <Button Click="Portrait_Click" Style="{StaticResource PanelTool}" FontSize="11.5"
                                Tag="{Binding Landscape, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe3c5;" />
                                <TextBlock Text="Portrait" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="Landscape_Click" Style="{StaticResource PanelTool}" FontSize="11.5" Tag="{Binding Landscape}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xe3c3;" />
                                <TextBlock Text="Landscape" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="Paper" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Papers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaperChoice}">
                                <Button Click="Paper_Click" Width="30" Height="30" Margin="0,0,6,6" ToolTip="{Binding Name}" Focusable="False"
                                        Background="{Binding Hex, Converter={StaticResource HexBrush}}" BorderThickness="2" t:Ui.CornerRadius="7">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Flat}">
                                            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#378add" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Header" IsChecked="{Binding ShowHeader, Mode=OneWay}" Click="Header_Click"
                              Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,6,0,6" />
                    <TextBox x:Name="HeaderBox" Style="{StaticResource InputBox}" Text="{Binding HeaderText, Mode=OneWay}"
                             t:Ui.Placeholder="{Binding SessionName}" LostFocus="HeaderText_LostFocus" KeyDown="HeaderText_KeyDown"
                             IsEnabled="{Binding ShowHeader}" FontSize="12" />
                    <CheckBox Content="Page numbers" IsChecked="{Binding ShowPageNumbers, Mode=OneWay}" Click="PageNumbers_Click"
                              Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ paper ============ -->
        <Grid Background="{StaticResource Bg}">
            <RichTextBox x:Name="Editor" HorizontalAlignment="Center" BorderThickness="0" Padding="0" Margin="0,18,0,0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FocusVisualStyle="{x:Null}"
                         Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisInv}}" />
            <Canvas x:Name="Markers" IsHitTestVisible="False" ClipToBounds="True"
                    Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisInv}}" />

            <DockPanel Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PageCountLabel}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreviewPages}" Margin="0,10,0,30">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="Center" Margin="0,0,0,22" BorderBrush="{StaticResource BorderHover}" BorderThickness="1">
                                    <Image Source="{Binding}" Stretch="Uniform" MaxWidth="640" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
