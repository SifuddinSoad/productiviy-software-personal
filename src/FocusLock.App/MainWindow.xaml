<Window x:Class="FocusLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusLock.App.ViewModels"
        xmlns:v="clr-namespace:FocusLock.App.Views"
        Title="Saidrix Studio"
        Width="1280" Height="820" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontSans}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <v:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}">
            <v:SetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LockScreenViewModel}">
            <v:LockScreenView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WhiteboardViewModel}">
            <v:WhiteboardView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}" />
</Window>
