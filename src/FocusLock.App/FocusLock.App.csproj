<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Program.Main decides between the app and the guard service; WPF's generated entry point would not. -->
    <StartupObject>FocusLock.App.Program</StartupObject>
    <AssemblyTitle>Focus Mood</AssemblyTitle>
    <Product>Focus Mood</Product>
    <!-- Drawn from Theme/Logo.xaml by scripts/make-icon.ps1. -->
    <ApplicationIcon>Assets\FocusMood.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusLock.Core\FocusLock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\FocusMood.ico" />
    <None Include="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
